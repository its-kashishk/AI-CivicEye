# Copy to .env and fill in. NEVER commit .env or real credentials.

# --- Required -------------------------------------------------------------------
# PostgreSQL connection string, e.g. postgresql://<user>:<password>@<host>:5432/<database>
DATABASE_URL=

# Secret used to sign bearer tokens (min 16 chars). Generate one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=

# --- ML integration -------------------------------------------------------------
# Base URL of the internal FastAPI ML service (docs/03). Leave empty to use the MOCK adapter.
ML_SERVICE_URL=
# mock | http | disabled  (default: http if ML_SERVICE_URL is set, otherwise mock)
# 'mock' is a rule-based stub for integration testing — NOT a trained model.
ML_MODE=
ML_TIMEOUT_MS=8000
# Below this confidence (percent) a modality result is not trusted -> needs_review
CATEGORY_CONFIDENCE_THRESHOLD_PCT=50

# --- Duplicate detection candidate retrieval (provisional, not validated) --------
DUPLICATE_WINDOW_DAYS=14
DUPLICATE_SEARCH_RADIUS_M=500

# --- Uploads (local-disk storage driver; directory is git-ignored) ---------------
UPLOAD_DIR=./uploads
MAX_IMAGE_BYTES=10485760
MAX_AUDIO_BYTES=10485760

# --- Auth ------------------------------------------------------------------------
TOKEN_TTL_SECONDS=43200

# --- Only used by tests (a SEPARATE database, never your dev database) ------------
# TEST_DATABASE_URL=
